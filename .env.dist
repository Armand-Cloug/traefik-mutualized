############################################################
# Traefik mutualisé — modèle de .env SERVEUR
############################################################

# Tag de l'image ghcr.io/armand-cloug/traefik-mutualized/traefik.
TRAEFIK_VERSION=v3.7.10

# Compte Let's Encrypt — écrit par la CI depuis la variable GitHub.
TRAEFIK_ACME_EMAIL=

# DEBUG le temps d'un diagnostic, INFO en régime normal.
TRAEFIK_LOG_LEVEL=INFO